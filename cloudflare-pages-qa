name: Cloudflare Pages - QA

# Nenhum commit publica o jogo automaticamente.
on:
  workflow_dispatch:
    inputs:
      operation:
        description: "O que deseja executar?"
        required: true
        type: choice
        default: validar
        options:
          - validar
          - publicar-qa

permissions:
  contents: read

concurrency:
  group: cloudflare-pages-qa
  cancel-in-progress: false

jobs:
  validar:
    name: Validar o jogo
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Obter arquivos do repositorio
        uses: actions/checkout@v6
        with:
          persist-credentials: false

      - name: Preparar Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "22"
          package-manager-cache: false

      - name: Extrair e conferir site.zip
        shell: bash
        run: |
          python3 - <<'PY'
          from pathlib import Path, PurePosixPath
          import shutil
          import stat
          import zipfile

          origem = Path('site.zip')
          destino = Path('dist')
          if not origem.is_file():
              raise SystemExit('ERRO: site.zip nao encontrado na raiz do repositorio')
          if destino.exists():
              shutil.rmtree(destino)
          destino.mkdir()

          with zipfile.ZipFile(origem) as pacote:
              itens = pacote.infolist()
              if len(itens) > 5000:
                  raise SystemExit('ERRO: ZIP possui arquivos demais')
              if sum(item.file_size for item in itens) > 350_000_000:
                  raise SystemExit('ERRO: ZIP descompactado excede o limite')

              nomes = set()
              for item in itens:
                  nome = item.filename
                  if nome == '.nojekyll' and not item.is_dir():
                      print('Ignorando .nojekyll (exclusivo do GitHub Pages)')
                      continue
                  caminho = PurePosixPath(nome)
                  partes = caminho.parts
                  if (not partes or caminho.is_absolute() or '..' in partes
                      or '\\' in nome or ':' in partes[0]):
                      raise SystemExit('ERRO: caminho inseguro no ZIP: ' + nome)
                  if any(p.startswith('.') and p != '.well-known' for p in partes):
                      raise SystemExit('ERRO: arquivo oculto proibido: ' + nome)
                  modo = item.external_attr >> 16
                  if stat.S_ISLNK(modo) or item.flag_bits & 1:
                      raise SystemExit('ERRO: link simbolico ou entrada cifrada: ' + nome)
                  if item.is_dir():
                      continue
                  if nome in nomes:
                      raise SystemExit('ERRO: arquivo duplicado no ZIP: ' + nome)
                  nomes.add(nome)
                  saida = destino.joinpath(*partes)
                  saida.parent.mkdir(parents=True, exist_ok=True)
                  with pacote.open(item) as entrada, saida.open('wb') as arquivo:
                      shutil.copyfileobj(entrada, arquivo)

          for nome in ('index.html', 'js', 'assets', 'tests'):
              if not (destino / nome).exists():
                  raise SystemExit('ERRO: recurso obrigatorio ausente no ZIP: ' + nome)
          if not (destino / 'index.html').is_file():
              raise SystemExit('ERRO: index.html precisa estar na raiz do ZIP')

          # Mesma politica de cabecalhos do pacote QA previamente testado.
          headers = destino / '_headers'
          if not headers.is_file():
              headers.write_text(
                  '/*\n'
                  "  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; worker-src 'none'; manifest-src 'self'; upgrade-insecure-requests\n"
                  '  X-Content-Type-Options: nosniff\n'
                  '  X-Frame-Options: DENY\n'
                  '  Referrer-Policy: no-referrer\n'
                  '  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()\n'
                  '  Strict-Transport-Security: max-age=31536000\n'
                  '  Cache-Control: public, max-age=0, must-revalidate\n',
                  encoding='utf-8',
              )
              print('Gerado dist/_headers para Cloudflare Pages')
          conteudo = headers.read_text(encoding='utf-8')
          if 'Content-Security-Policy:' not in conteudo or 'X-Frame-Options:' not in conteudo:
              raise SystemExit('ERRO: _headers sem CSP e protecao contra iframes')

          print('ZIP extraido com seguranca e estrutura validada')
          PY

      - name: Verificar sintaxe dos JavaScripts
        shell: bash
        run: |
          mapfile -d '' scripts < <(find dist/js -type f -name '*.js' -print0)
          if [ "${#scripts[@]}" -eq 0 ]; then
            echo '::error::Nenhum JavaScript encontrado em dist/js'
            exit 1
          fi
          for script in "${scripts[@]}"; do
            node --check "$script"
          done
          echo "Sintaxe OK: ${#scripts[@]} arquivos JavaScript"

      - name: Verificar e executar os tres testes obrigatorios
        shell: bash
        run: |
          cd dist
          testes=(
            tests/scenery_npcs.test.js
            tests/sidewalk_runners.test.js
            tests/combat_stamina.test.cjs
          )
          for teste in "${testes[@]}"; do
            if [ ! -f "$teste" ]; then
              echo "::error::Teste obrigatorio ausente no site.zip: $teste"
              echo 'Atualize o site.zip do GitHub com a versao Alpha 0.9.5 que contem tests/.'
              exit 1
            fi
            echo "Teste encontrado: $teste"
          done
          # Um teste ausente ou reprovado interrompe a execucao.
          node --test "${testes[@]}"

      - name: Preparar somente os arquivos publicos
        shell: bash
        run: |
          rm -rf dist/tests dist/docs dist/laboratorio
          rm -f dist/*.md dist/VERSAO.txt dist/animacoes.html dist/teste_*.html
          test -s dist/index.html
          test -s dist/_headers
          if find dist \( -name '.git' -o -name '.github' -o -name '.env' \) -print | grep -q .; then
            echo '::error::Arquivos internos identificados na distribuicao'
            exit 1
          fi
          echo "Arquivos publicos preparados: $(find dist -type f | wc -l)"

      - name: Salvar pacote validado
        uses: actions/upload-artifact@v6
        with:
          name: site-validado
          path: dist/
          include-hidden-files: true
          if-no-files-found: error
          retention-days: 7

  publicar_qa:
    name: Publicar no Cloudflare QA
    needs: validar
    if: ${{ inputs.operation == 'publicar-qa' && github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Configure Required reviewers no ambiente cloudflare-qa.
    # QA e publico; publicar apenas com autorizacao para exposicao publica.
    environment: cloudflare-qa

    steps:
      - name: Baixar exatamente o pacote validado
        uses: actions/download-artifact@v7
        with:
          name: site-validado
          path: dist

      - name: Conferir arquivos antes de enviar
        shell: bash
        run: |
          test -s dist/index.html
          test -s dist/_headers
          test -d dist/assets
          test -d dist/js

      - name: Deploy Cloudflare Pages (nao Workers)
        uses: cloudflare/wrangler-action@v4
        with:
          apiToken: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          accountId: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
          wranglerVersion: '4.152.0'
          command: pages deploy dist --project-name=lula-correndo-democracia-qa --branch=main
